#############################
# Ambiente Backend Restaurante
#############################

# Configuración MySQL (contenedor)
MYSQL_ROOT_PASSWORD=Root12345!
MYSQL_DATABASE=restauranteDB
MYSQL_USER=appuser
MYSQL_PASSWORD=App12345!
TZ=America/Guatemala

# Servidor
PORT=4000
NODE_ENV=development
FRONT_ORIGIN=http://localhost:4000

# Conexión DB usada por el backend
DB_HOST=db
DB_PORT=3306
DB_USER=appuser
DB_PASSWORD=App12345!
DB_NAME=restauranteDB

# Autenticación / JWT
JWT_SECRET=supersecretocambiar
ADMIN_EMAIL=admin@restaurante.com
ADMIN_PASSWORD=Admin123!
ADMIN_NAME=Administrador

# NOTA: Para desarrollo local fuera de Docker usar .env.local con DB_HOST=localhost y DB_PORT=3308